<div id="grav-ai-chatbot-root" class="grav-chatbot-container {{ config.plugins['ai-chatbot'].position|default('bottom-right') }} theme-{{ config.plugins['ai-chatbot'].theme_preset|default('glass_blue') }}">
  <!-- Proactive Notification Toast -->
  <div id="grav-chatbot-toast" class="grav-chatbot-toast" style="display: none;">
    <span id="grav-chatbot-toast-text" class="grav-chatbot-toast-text">{{ config.plugins['ai-chatbot'].notification_text|default('👋 Hi there! Need help finding anything on our website?') }}</span>
    <button id="grav-chatbot-toast-close" class="grav-chatbot-toast-close">&times;</button>
  </div>

  <!-- Floating Launcher Button -->
  <button id="grav-chatbot-toggle" class="grav-chatbot-launcher" aria-label="Open Chatbot">
    <svg class="grav-chatbot-icon-chat" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <svg class="grav-chatbot-icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <!-- Chat Window Box -->
  <div id="grav-chatbot-window" class="grav-chatbot-window" style="display: none;">
    <!-- Header -->
    <div class="grav-chatbot-header" style="background-color: {{ config.plugins['ai-chatbot'].accent_color|default('#3b82f6') }};">
      <div class="grav-chatbot-title">
        <span class="grav-chatbot-status-dot"></span>
        <span class="grav-chatbot-title-text">{{ config.plugins['ai-chatbot'].bot_title|default('Website Assistant') }}</span>
      </div>
      <button id="grav-chatbot-close" class="grav-chatbot-header-close">&times;</button>
    </div>

    <!-- Message Feed -->
    <div id="grav-chatbot-messages" class="grav-chatbot-messages">
      <div class="grav-chatbot-msg assistant">
        <div class="grav-chatbot-bubble">
          {{ config.plugins['ai-chatbot'].welcome_message|default('Hello! How can I help you with this website today?') }}
        </div>
      </div>
    </div>

    <!-- Quick Action Pills -->
    {% if config.plugins['ai-chatbot'].quick_replies_enabled|default(true) %}
      <div class="grav-chatbot-quick-actions">
        {% set replies = config.plugins['ai-chatbot'].quick_replies|default([
          {'label': '📝 Summarize Page', 'type': 'action', 'action_or_prompt': 'summarize_page'},
          {'label': '📞 Contact Owner', 'type': 'action', 'action_or_prompt': 'contact'},
          {'label': '❓ Founding Date', 'type': 'question', 'action_or_prompt': 'When was this company established?'}
        ]) %}
        {% for item in replies %}
          {% if item.type == 'action' %}
            <button type="button" class="grav-chatbot-pill" data-action="{{ item.action_or_prompt|e('html_attr') }}">{{ item.label }}</button>
          {% else %}
            <button type="button" class="grav-chatbot-pill" data-prompt="{{ item.action_or_prompt|e('html_attr') }}">{{ item.label }}</button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <!-- Input Form -->
    <form id="grav-chatbot-form" class="grav-chatbot-input-area">
      <input type="text" id="grav-chatbot-input" placeholder="Ask a question about this site..." autocomplete="off" />
      <button type="submit" id="grav-chatbot-send" aria-label="Send Message" style="background-color: {{ config.plugins['ai-chatbot'].accent_color|default('#3b82f6') }};">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>

    <!-- Sensitivity & Privacy Warning Disclaimer -->
    <div class="grav-chatbot-disclaimer">
      🔒 Please do not enter sensitive or personal information.
    </div>
  </div>
</div>
